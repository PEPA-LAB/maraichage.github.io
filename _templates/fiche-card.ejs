```{=html}
<div class="list fiche-grid">
<% for (const item of items) { %>
<% const r = item.ressources || {}; const img = item.image ? String(item.image).replace(/^\//, '') : 'images/banniere.jpg'; %>
<a class="fiche-card" href="<%- item.path %>" <%= metadataAttrs(item) %>>
<div class="fiche-img" style="background-image:url('<%- img %>')">
<% const st = item.statut || 'Préliminaire'; const stc = st === 'Publié' ? 'publie' : st === 'Consolidé' ? 'consolide' : 'preliminaire'; %>
<span class="statut-badge statut-<%= stc %> statut-carte"><%= st %></span>
<div class="kpi"><b><%= item.kpi || '' %></b><span><%= item.kpi_label || '' %></span></div>
</div>
<div class="fiche-body">
<div class="fiche-meta"><%= item.type || 'Essai' %> · <%= item.annee || '' %></div>
<h3 class="listing-title"><%= item.title %></h3>
<p class="fiche-resultat listing-description"><%= item.resultat || '' %></p>
<div class="fiche-pills">
<% if (item.culture) { %><span class="pill cu"><%= item.culture %></span><% } %>
<% for (const c of (item.categories || [])) { if (c !== item.culture) { %><span class="pill th listing-category"><%= c %></span><% } } %>
<% if (r.memoire) { %><span class="pill fi">PDF</span><% } %>
<% if (r.donnees) { %><span class="pill fi">CSV</span><% } %>
<% if (r.doi) { %><span class="pill fi">DOI</span><% } %>
<% if (r.code) { %><span class="pill fi">Code</span><% } %>
</div>
</div>
</a>
<% } %>
</div>
```
